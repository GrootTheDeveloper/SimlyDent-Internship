<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.4" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="9.0.4" />
    <PackageReference Include="Npgsql" Version="9.0.3" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.7.0" />
  </ItemGroup>
  <!-- Keep unit tests out of the web app compile graph -->
  <ItemGroup>
    <Compile Remove="LiveKitPoc.Api.Tests/**" />
    <Content Remove="LiveKitPoc.Api.Tests/**" />
    <None Remove="LiveKitPoc.Api.Tests/**" />
    <EmbeddedResource Remove="LiveKitPoc.Api.Tests/**" />
  </ItemGroup>
</Project>

