# Copy to .env on the VPS, then fill real values:
#   cp .env.vps.example .env

# Public DNS name pointing A-record to this VPS (required for HTTPS + camera).
DOMAIN=call.example.com

# Same host is fine for TURN in PoC; can use turn.example.com later.
TURN_DOMAIN=call.example.com

# VPS public IPv4 (not private/docker IP). Used as LiveKit --node-ip.
PUBLIC_IP=203.0.113.10

# Let's Encrypt contact email
ACME_EMAIL=you@example.com

# Long random secret (do not reuse LAN PoC secret if you can avoid it)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=replace-with-long-random-secret

# Staff JWT + embed visitor JWT (required on VPS; no known defaults)
#   openssl rand -base64 48
JWT_SECRET=replace-with-long-random-staff-jwt-secret
EMBED_JWT_SECRET=replace-with-long-random-embed-jwt-secret
REQUIRE_STRICT_SECRETS=1
EMBED_JWT_LIFETIME_MINUTES=120
EMBED_RATE_LIMIT_PER_MINUTE=30
# Ghost-queue cleanup vs reload recovery (embed visitor poll heartbeat)
EMBED_VISITOR_STALE_WAITING_SECONDS=30
EMBED_VISITOR_STALE_INCALL_SECONDS=90

# Exact origins allowed to call POST /embed/session (scheme+host+port).
# Use DISTINCT origins for clinic A vs B demos (not two paths on same host).
# Example local multi-port: http://127.0.0.1:5174 and http://127.0.0.1:5175
EMBED_ORIGINS_CLINIC_A=https://clinic-a.example.com
EMBED_ORIGINS_CLINIC_B=https://clinic-b.example.com
# Optional: allow same-host widget demos (/widget/demo-a.html) — also needed if demos share DOMAIN
# EMBED_PUBLIC_ORIGIN=https://call.example.com
