# Public HTTPS gateway for VPS.
# Requires DOMAIN in environment (e.g. call.example.com).
# Caddy obtains Let's Encrypt certificates automatically on ports 80/443.

{
  email {$ACME_EMAIL}
}

{$DOMAIN} {
  encode gzip

  @api path /api/*
  handle @api {
    reverse_proxy backend:8080
  }

  # Phase 2 public embed API (must not fall through to frontend SPA)
  @embed path /embed/*
  handle @embed {
    reverse_proxy backend:8080
  }

  @hubs path /hubs/*
  handle @hubs {
    reverse_proxy backend:8080
  }

  # LiveKit signaling WebSocket (ws/wss://DOMAIN/rtc)
  @livekit path /rtc*
  handle @livekit {
    reverse_proxy livekit:7880
  }

  # Optional: public /health → backend (otherwise SPA catches bare /health)
  @health path /health
  handle @health {
    reverse_proxy backend:8080
  }

  handle {
    reverse_proxy frontend:80
  }
}

# Optional Phase C S3 site is appended by scripts/start-vps.sh when S3_DOMAIN is set
# (dedicated host s3.DOMAIN → minio:9000, Host/URI preserved for SigV4).
