{
	# Accept TLS for IP, localhost, and SSH-tunnel hosts (127.0.0.1).
	default_sni {$LAN_IP}
	local_certs
}

# Bind by port only so Host can be 10.11.10.23 or 127.0.0.1 (SSH tunnel).
https://:8443 {
  tls internal

  @api path /api/*
  reverse_proxy @api backend:8080

  @hubs path /hubs/*
  reverse_proxy @hubs backend:8080

  @livekit path /rtc*
  reverse_proxy @livekit livekit:7880

  reverse_proxy frontend:80
}

:8088 {
  root * /data/caddy/pki/authorities/local
  file_server
}
